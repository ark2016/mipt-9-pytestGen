# Any OpenAI-compatible endpoint. Examples:
#   llama.cpp (docker compose):  http://llm:8080/v1   (from host: http://localhost:8080/v1)
#   Ollama:                      http://localhost:11434/v1
#   OpenRouter:                  https://openrouter.ai/api/v1
PYTESTGEN_LLM_BASE_URL=http://localhost:8080/v1
PYTESTGEN_LLM_MODEL=qwen2.5-coder-1.5b-instruct
# PYTESTGEN_LLM_API_KEY=sk-...
# json_schema | json_object | none  (depends on what the provider supports)
PYTESTGEN_LLM_JSON_MODE=json_schema
PYTESTGEN_LOG_LEVEL=INFO

# --- docker compose (docker-compose.yml reads these from .env; all are optional) ---
# Model served by the `llm` container (llama.cpp downloads it from Hugging Face on first start).
# LLM_HF_REPO=Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF
# LLM_HF_QUANT=Q4_K_M
# Must match what pytestgen asks for: becomes llama-server --alias and PYTESTGEN_LLM_MODEL.
# LLM_MODEL_NAME=qwen2.5-coder-1.5b-instruct
# LLM_CTX_SIZE=8192
# LLM_THREADS=-1
# LLM_MEM_LIMIT=6g
# LLM_HOST_PORT=8080
# PYTESTGEN_IMAGE=pytestgen:local
