# Compose overrides for the larger model (Qwen2.5-Coder-3B, ~2.1 GB download, ~6-8 GB RAM):
#   docker compose --env-file scripts/llm-3b.env run --rm --build pytestgen
# --env-file replaces the default .env, so put other overrides in this file too.
LLM_HF_REPO=Qwen/Qwen2.5-Coder-3B-Instruct-GGUF
LLM_HF_QUANT=Q4_K_M
LLM_MODEL_NAME=qwen2.5-coder-3b-instruct
LLM_MEM_LIMIT=8g
